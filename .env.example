# ==============================================================================
# Kala Setu Marketplace - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` for local development.
# 2. Populate with your project's non-production development credentials.
# 3. DO NOT commit `.env.local` or any production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public Supabase URL (client & server accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon Key (client & server accessible, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-Only Supabase Service Role Key (BYPASSES RLS - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Public Razorpay Key ID (used by frontend Razorpay checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_placeholder

# Server-Only Razorpay Key ID (optional if same as public key, used by backend API)
RAZORPAY_KEY_ID=rzp_test_your_key_id_placeholder

# Server-Only Razorpay Secret (NEVER expose to browser, used for HMAC signatures)
RAZORPAY_KEY_SECRET=your_razorpay_secret_placeholder

# Server-Only Razorpay Webhook Secret (Configured in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder
